                <mxCell id="H5" value="&lt;b&gt;[5] NotificationContentView.calculateVisibleType()&lt;/b&gt;&lt;br&gt;afterHook — if mIsHeadsUp &amp;&amp; result==2 (contracted)&lt;br&gt;skip when isGroup or aeCollapsed&lt;br&gt;else result = 1 (expanded child)&lt;br&gt;&lt;i&gt;+ recovery: OEMs whose addNotification we can&#39;t hook&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
