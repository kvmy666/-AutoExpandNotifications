    <diagram id="page2" name="2 - خريطة خطافات الإشعارات">
        <mxGraphModel dx="2292" dy="1292" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="NotificationExpander.install(lpparam) — 11 static hook sites + 1 installed lazily at runtime" style="text;html=1;fontSize=16;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="secA" value="A — SHADE / LOCK SCREEN  (توسيع تلقائي)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="70" width="1180" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="H1" value="&lt;b&gt;[1] ExpandableNotificationRow.setSystemExpanded(boolean)&lt;/b&gt;&lt;br&gt;findAndHookMethod → afterHookedMethod&lt;br&gt;&lt;i&gt;fast first-open path — fires only on post / set-change&lt;/i&gt;&lt;br&gt;guards: !mIsHeadsUp, !isChildInGroup&lt;br&gt;one-shot aeAutoExpanded + 300 ms gap via aeLastSysExpTs&lt;br&gt;action: rowView.post { setUserExpanded(true,true) ?: performClick }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="55" y="110" width="360" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="H2" value="&lt;b&gt;[2] ExpandableNotificationRow.onLayout(...)&lt;/b&gt;   ★ UNIVERSAL DRIVER&lt;br&gt;XposedBridge.hookAllMethods → afterHookedMethod&lt;br&gt;&lt;i&gt;the only trigger that fires on EVERY shade / LS open&lt;/i&gt;&lt;br&gt;guards: !mIsHeadsUp, !isChildInGroup, rowView.isShown&lt;br&gt;one-shot aeAutoExpanded + 300 ms gap via aeLastLayoutTs&lt;br&gt;collapse signal: group → areChildrenExpanded()==false&lt;br&gt;                       single → isShowingExpanded()==false&lt;br&gt;action: performClick on the REAL system arrow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="55" y="240" width="360" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="HA1" value="shouldSkipNotification(featureKey, pkg)&lt;br&gt;→ prefs.isFeatureEnabled(key) &amp;&amp; pkg ∉ excluded_apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="470" y="110" width="290" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="HA2" value="isGroupSummaryRow(row)&lt;br&gt;FLAG_GROUP_SUMMARY &amp;&amp; getRowChildCount &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="470" y="165" width="290" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="HA3" value="findStrictExpandButton(view) → findExpandButtonImpl(strict=true)&lt;br&gt;pkg==&quot;android&quot; &amp;&amp; id==expand_button&lt;br&gt;&amp;&amp; class == com.android.internal.widget.NotificationExpandButton&lt;br&gt;DFS, skips nested ExpandableNotificationRow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="470" y="220" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="HA4" value="clickExpandSilentlyOnKeyguard(row, btn)&lt;br&gt;1) beginLsAutoExpandWindow() — 400 ms&lt;br&gt;2) null the mOnExpandClickListener field&lt;br&gt;3) btn.performClick()&lt;br&gt;4) restore listener in finally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="470" y="300" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="H12" value="&lt;b&gt;[12] &amp;lt;listener&amp;gt;.onExpandClicked(...)&lt;/b&gt;  — DYNAMIC&lt;br&gt;hookAllMethods, installed lazily by ensureOnExpandClickedHook()&lt;br&gt;from the first listener instance observed&lt;br&gt;beforeHook: if uptimeMillis &amp;lt; lsAutoExpandUntil → setResult(null)&lt;br&gt;&lt;i&gt;kills the keyguard → locked-shade scrim / unlock prompt&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="810" y="290" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="HA5" value="getExpandClickListenerField(row)&lt;br&gt;walks the class hierarchy for a field whose name contains&lt;br&gt;&quot;expandclick&quot; or type contains &quot;onexpandclicklistener&quot;&lt;br&gt;cached in expandClickField / expandClickFieldResolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="810" y="180" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="secB" value="B — HEADS-UP (HUD)  (توسيع + ضبط الأبعاد)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="420" width="1180" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="H3" value="&lt;b&gt;[3] NotificationChildrenContainer.addNotification(row, int)&lt;/b&gt;&lt;br&gt;afterHook — fires when a child attaches to a group&lt;br&gt;branch: only when parent mIsHeadsUp == true&lt;br&gt;→ aeIsGroup = true&lt;br&gt;→ parent setUserExpanded(true, true)&lt;br&gt;→ collapseChildNoAnim(child)  (kills expanded-frame flicker)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="55" y="460" width="360" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="H4" value="&lt;b&gt;[4] ExpandableNotificationRow.setHeadsUp(boolean)&lt;/b&gt;&lt;br&gt;beforeHook(true)  → aeIsGroup=false (if unset), aeCollapsed=false&lt;br&gt;beforeHook(false) → reset aeIsGroup, aeAutoExpanded&lt;br&gt;afterHook(true)   → expandGroupIfNeeded(rowView, row, pkg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
