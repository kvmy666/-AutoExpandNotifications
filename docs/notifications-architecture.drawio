                <mxCell id="C6" value="11 static hook sites + 1 dynamic&lt;br&gt;(see page 2 — خريطة الخطافات)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
