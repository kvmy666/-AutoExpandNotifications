                </mxCell>
                <mxCell id="H7" value="&lt;b&gt;[7] ExpandableNotificationRow.getPinnedHeadsUpHeight(boolean)&lt;/b&gt;&lt;br&gt;afterHook — HU + non-group + !aeCollapsed only&lt;br&gt;result = max(result, getMaxExpandHeight())" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
