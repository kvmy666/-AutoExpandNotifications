                <mxCell id="HC1" value="toggleHeadsUpExpandState(row)&lt;br&gt;group (aeIsGroup) → findExpandButton().performClick()&lt;br&gt;single → flip aeCollapsed, set mExpandedWhenPinned,&lt;br&gt;         setActualHeight(getIntrinsicHeight()), requestLayout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1265" y="410" width="430" height="80" as="geometry"/>
