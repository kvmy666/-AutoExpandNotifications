                <mxCell id="N1" value="system_server (&quot;android&quot;) also loads MainHook,&#xa;but only for SnapperChordHook. It reads prefs via&#xa;PrefsBridge.systemCtx = ActivityThread.getSystemContext().&#xa;No notification hook runs there." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="200" width="270" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="N2" value="Every notification pref change needs a SystemUI restart&#xa;ONLY for newly-added hook code. Values themselves are&#xa;picked up live within ≤2 s (reloadIfStale) — but the UI&#xa;still shows the &quot;reboot required&quot; snackbar for every toggle." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="315" width="270" height="110" as="geometry"/>
