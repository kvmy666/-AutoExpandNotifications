                <mxCell id="C3" value="hook android.app.Application.onCreate (after)&lt;br&gt;• prefs.appContext = app&lt;br&gt;• prefs.loadFilePrefs()&lt;br&gt;• prefs.startFileObserver()&lt;br&gt;• prefs.startHeartbeatThread()  (60 s daemon)&lt;br&gt;• legacy autoexpand_active marker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
