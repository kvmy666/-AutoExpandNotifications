                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;PER-ROW STATE (XposedHelpers.setAdditionalInstanceField)&lt;/b&gt;&lt;br&gt;&lt;br&gt;aeAutoExpanded : Boolean — one-shot &quot;already expanded this open&quot;&lt;br&gt;aeLastSysExpTs : Long — last setSystemExpanded timestamp (quiet-gap reset)&lt;br&gt;aeLastLayoutTs : Long — last onLayout timestamp (quiet-gap reset)&lt;br&gt;aeIsGroup      : Boolean — row is a HUD group parent&lt;br&gt;aeCollapsed    : Boolean — our own HUD expand state (independent of mExpandedWhenPinned timing)&lt;br&gt;&lt;br&gt;&lt;b&gt;CLASS-LEVEL STATE (@Volatile)&lt;/b&gt;&lt;br&gt;f1DownStartY / f1IsDownwardSwipe / f1HasToggled / f1SwipeTime / f1CurrentRow — swipe tracking&lt;br&gt;lsAutoExpandUntil — keyguard suppression window end (uptimeMillis + 400)&lt;br&gt;onExpandClickedHooked — dynamic hook installed flag&lt;br&gt;expandClickField / expandClickFieldResolved — reflection cache" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=18;align=left;spacingLeft=8;fontSize=10;" parent="1" vertex="1">
